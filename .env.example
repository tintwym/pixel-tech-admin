# Pixel Tech admin — copy to `.env` (never commit `.env`)

# Spring API origin (no trailing slash, no /api suffix)
# Local Docker / mvnw:
# API_PROXY_TARGET=http://127.0.0.1:8081
# Production (Render):
API_PROXY_TARGET=https://YOUR-SERVICE.onrender.com

# Storefront URL for the "Back to store" link on the sign-in page
NEXT_PUBLIC_STORE_URL=http://127.0.0.1:3000
